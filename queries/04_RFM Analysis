--Determine the Analysis Date
--Find the most recent transaction date to calculate customer recency.

CREATE OR REPLACE TABLE `retail-customer-analytics.retail_analysis.rfm_analysis` AS

WITH analysis_date AS (
    SELECT
        MAX(InvoiceDate) AS MaxDate
    FROM `retail-customer-analytics.retail_analysis.cleaned_retail`
),

--Calculate RFM Metrics
--R = Days since the customer's last purchase
--F = Number of unique purchases
--M = Total revenue generated by the customer

rfm_metrics AS (

SELECT
    Customer,

    DATE_DIFF(
        DATE((SELECT MaxDate FROM analysis_date)),
        DATE(MAX(InvoiceDate)),
        DAY
    ) AS Recency,

    COUNT(DISTINCT Invoice) AS Frequency,

    ROUND(SUM(Revenue),2) AS Monetary

FROM `retail-customer-analytics.retail_analysis.cleaned_retail`

GROUP BY Customer

),
--Assign RFM Scores
--Divide customers into 5 groups using NTILE().
--Higher scores represent better customer value.
rfm_scores AS (

SELECT
*,

NTILE(5) OVER(ORDER BY Recency DESC) AS R_Score,

NTILE(5) OVER(ORDER BY Frequency ASC) AS F_Score,

NTILE(5) OVER(ORDER BY Monetary ASC) AS M_Score

FROM rfm_metrics

)

--Calculate Overall RFM Score
--Combine the three scores into a single RFM score.

SELECT

Customer,
Recency,
Frequency,
Monetary,

R_Score,
F_Score,
M_Score,

(R_Score + F_Score + M_Score) AS RFM_Score,
--Segment Customers
--Classify customers based on their RFM score.
CASE

WHEN (R_Score + F_Score + M_Score) >= 13 THEN 'Champions'

WHEN (R_Score + F_Score + M_Score) >= 11 THEN 'Loyal Customers'

WHEN (R_Score + F_Score + M_Score) >= 9 THEN 'Potential Loyalists'

WHEN (R_Score + F_Score + M_Score) >= 7 THEN 'Needs Attention'

WHEN (R_Score + F_Score + M_Score) >= 5 THEN 'At Risk'

ELSE 'Lost Customers'

END AS Customer_Segment

FROM rfm_scores;

--View the Final RFM Analysis Table

SELECT *
FROM `retail-customer-analytics.retail_analysis.rfm_analysis`
ORDER BY RFM_Score DESC;
