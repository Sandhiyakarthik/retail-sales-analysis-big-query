-- Revenue by Customer Segment

SELECT
Customer_Segment,
FORMAT("%'0.2f",ROUND(SUM(Monetary),2)) AS Total_Revenue
FROM `retail-customer-analytics.retail_analysis.rfm_analysis`
GROUP BY Customer_Segment
ORDER BY Total_Revenue DESC;

-- Customer Count by Segment

SELECT
Customer_Segment,
COUNT(Customer) AS Total_Customers
FROM `retail-customer-analytics.retail_analysis.rfm_analysis`
GROUP BY Customer_Segment
ORDER BY Total_Customers DESC;
-- Average Customer Value by Segment

SELECT
Customer_Segment,
ROUND(AVG(Monetary),2) AS Avg_Customer_Value
FROM `retail-customer-analytics.retail_analysis.rfm_analysis`
GROUP BY Customer_Segment
ORDER BY Avg_Customer_Value DESC;
-- Revenue Contribution Percentage

SELECT

Customer_Segment,

ROUND(SUM(Monetary),2) AS Revenue,

ROUND(
100*SUM(Monetary)/SUM(SUM(Monetary)) OVER(),
2
) AS Revenue_Percentage

FROM `retail-customer-analytics.retail_analysis.rfm_analysis`

GROUP BY Customer_Segment

ORDER BY Revenue DESC;
-- Top 10 Customers

SELECT

Customer,

Monetary,

Customer_Segment

FROM `retail-customer-analytics.retail_analysis.rfm_analysis`

ORDER BY Monetary DESC

LIMIT 10;

-- Customers at Risk

SELECT

Customer,

Recency,

Frequency,

Monetary

FROM `retail-customer-analytics.retail_analysis.rfm_analysis`

WHERE Customer_Segment='At Risk'

ORDER BY Monetary DESC;
-- Lost Customers

SELECT

Customer,

Recency,

Frequency,

Monetary

FROM `retail-customer-analytics.retail_analysis.rfm_analysis`

WHERE Customer_Segment='Lost Customers'

ORDER BY Recency DESC;
-- Top Countries

SELECT

Country,

ROUND(SUM(Revenue),2) AS Revenue

FROM `retail-customer-analytics.retail_analysis.cleaned_retail`

GROUP BY Country

ORDER BY Revenue DESC;
-- Best Selling Products

SELECT

Description,

SUM(Quantity) AS Units_Sold,

ROUND(SUM(Revenue),2) AS Revenue

FROM `retail-customer-analytics.retail_analysis.cleaned_retail`

GROUP BY Description

ORDER BY Revenue DESC

LIMIT 10;
-- Monthly Sales Performance

SELECT

FORMAT_DATETIME('%Y-%m',InvoiceDate) AS Month,

ROUND(SUM(Revenue),2) AS Revenue

FROM `retail-customer-analytics.retail_analysis.cleaned_retail`

GROUP BY Month

ORDER BY Month;
